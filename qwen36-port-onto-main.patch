+async function loadTickets() {
+  setTicketStatus('جاري التحميل...');
+  try {
+    const filter = $('ticketStatusFilter').value;
+    const url = '/api/admin/tickets' + (filter ? ('?status=' + encodeURIComponent(filter)) : '');
