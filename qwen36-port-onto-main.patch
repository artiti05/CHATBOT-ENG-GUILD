+const REASON_LABELS = { user_intent: 'طلب مستخدم', low_confidence: 'ثقة منخفضة' };
+const STATUS_LABELS = { open: 'مفتوحة', in_progress: 'قيد المعالجة', resolved: 'تم الحل', closed: 'مغلقة' };
