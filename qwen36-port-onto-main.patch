+        first = occurrences[0]
+        stitched = stitched[:first.start()] + content + stitched[first.end():]
+        tokens_matched += 1
+
+    if unresolved:
+        stitched = stitched + "\n\n" + "\n\n".join(unresolved)
+
+    return stitched, tables_extracted, tokens_matched
