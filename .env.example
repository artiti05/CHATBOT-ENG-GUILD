# Authentication — REQUIRED. Generate with: openssl rand -hex 32
ADMIN_API_KEY=your_super_secret_admin_key_here
USER_API_KEY=your_super_secret_user_key_here

# LLM / VLM providers
LLM_PROVIDER=ollama
VLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=ministral-3:8b
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# Embeddings
EMBEDDING_PROVIDER=bge-m3
QWEN_EMBEDDING_MODEL_NAME=Alibaba-NLP/gte-Qwen2-1.5B-instruct

# CORS (comma-separated origins, leave empty for server-to-server only)
CORS_ORIGINS=

# Moderation Alerts & Outbound Webhook (Optional)
ENABLE_MODERATION_ALERTS=true
MODERATION_WEBHOOK_URL=
MODERATION_WEBHOOK_TOKEN=
MODERATION_WEBHOOK_TIMEOUT=3.0